# OTAI Desk environment variables
# Copy to .env and adjust for your environment

# Database
DATABASE_URL=postgresql+asyncpg://otai:otai@localhost:5432/otai_desk

# Application
OTAI_DESK_HOST=0.0.0.0
OTAI_DESK_PORT=8000
OTAI_DESK_DEBUG=true

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
OTAI_DESK_SECRET_KEY=change-me-in-production
