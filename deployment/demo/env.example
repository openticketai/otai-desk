# Copy to `.env` on the VM before `docker compose up`.
# Never commit the populated `.env`.

POSTGRES_PASSWORD=change-me
OTAI_DESK_SECRET_KEY=change-me-long-random-string
# Bearer token Studio uses against the helpdesk REST API. At least 16 characters.
OTAI_DESK_API_TOKEN=change-me-line-api-token
OTAI_DESK_CORS_ORIGINS=*
OTAI_DESK_SEED_DEMO=true
NUXT_PUBLIC_API_BASE=

# Studio (Caddy: /studio/ and /studio-api/). Secrets need 32+ characters and punctuation.
OTAI_SESSION_SECRET=change-me-session-secret-32chars!!
OTAI_SSO_SECRET=change-me-sso-secret-32chars-min!!
OTAI_API_TOKEN=change-me-studio-api-token
OTAI_SESSION_TTL_SECONDS=604800
OTAI_STUDIO_APP_URL=http://desk-demo.openticketai.com/studio
OTAI_TICKET_SYSTEM_PUBLIC_URL=http://desk-demo.openticketai.com
# License JWT. Studio API exits on startup when this is empty.
OTAI_LICENSE_KEY=
OTAI_SOFTWARE_VERSION=1.2.0
OTAI_LLM_PROVIDER=openrouter
OTAI_LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenLDAP admin bind: cn=admin,dc=openticketai,dc=test
LDAP_ADMIN_PASSWORD=otai-test-ldap
# Keycloak admin console is http://<host>/auth/ (user: admin)
KEYCLOAK_ADMIN_PASSWORD=otai-test-keycloak
# Directory users admin, agent, and employee use password demo-password.
# Groups: helpdesk-admins, helpdesk-agents, helpdesk-employees.
# OIDC issuer: http://<host>/auth/realms/otai  client: otai-line
