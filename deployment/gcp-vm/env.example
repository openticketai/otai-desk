# Copy to `.env` before running 01-provision-vm.sh / deploy-to-vm.ps1.
# Never commit the populated `.env`.

PROJECT_ID=otai-studio-firebase
REGION=europe-west3
ZONE=europe-west3-a
INSTANCE_NAME=otai-desk-demo
MACHINE_TYPE=e2-standard-2
DISK_SIZE_GB=40
IMAGE_FAMILY=ubuntu-2404-lts-amd64
IMAGE_PROJECT=ubuntu-os-cloud
NETWORK_TAG=otai-desk-demo
ADMIN_SOURCE_RANGES=0.0.0.0/0
